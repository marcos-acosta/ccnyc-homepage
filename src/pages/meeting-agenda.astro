---
import Layout from "../layouts/Layout.astro";

const signupEndpoint =
  import.meta.env.PUBLIC_PRESENTATION_SIGNUP_URL ??
  "https://script.google.com/macros/s/AKfycbx2eBlA1Xt_zF3w4r2FzZJ6faH5f0d7MnpYE4PPH64zThko_eYMhH7VGPkAXZokMeO1/exec";
---

<Layout>
  <main class="signupPage" data-signup-endpoint={signupEndpoint}>
    <div class="siteIntro">
      <a class="brandLink" href="/" aria-label="Back to CCNYC homepage">CCNYC</a>
      <p>Welcome to Creative Coding NYC</p>
    </div>
    <p class="meetingDate">Every Tuesday</p>

    <div class="contentGrid">
      <section class="agendaSection" aria-labelledby="agenda-heading">
        <header>
          <p class="eyebrow"><span id="meeting-date">Tuesday meetup</span> · 6–8 PM</p>
          <h1 id="agenda-heading">Meeting agenda</h1>
          <p class="progressStatus" id="progress-status">Meetup starts at 6 PM</p>
        </header>

        <div class="agendaBody">
          <div class="meetingProgress">
            <div
              class="progressTrack"
              id="meeting-progress"
              role="progressbar"
              aria-label="Tuesday meetup progress"
              aria-valuemin="0"
              aria-valuemax="100"
              aria-valuenow="0"
            >
              <span id="progress-fill"></span>
            </div>
          </div>

          <ol class="agenda" aria-label="Tuesday meeting agenda">
            <li>
              <time>6:00–7:20</time>
              <div><strong>Chill, code, collaborate</strong><span>Settle in, make something, and meet people.</span></div>
            </li>
            <li>
              <time>7:20–7:30</time>
              <div><strong>Announcements</strong><span>Community news, events, and opportunities.</span></div>
            </li>
            <li>
              <time>7:30–8:00</time>
              <div><strong>Demos</strong><span>Members share what they’ve been working on.</span></div>
            </li>
          </ol>
        </div>

        <a class="qrPrompt" href="#demo-signup" aria-label="Go to demo signup">
          <span class="qrCopy">
            <strong>Sign up for demos</strong>
            <small>Scan the QR code</small>
          </span>
          <img
            src="https://quickchart.io/qr?text=https%3A%2F%2Fccnyc.space%2Fmeeting-agenda&size=220&margin=2&dark=ffffff&light=00000000"
            width="150"
            height="150"
            alt="QR code for the CCNYC demo signup page"
          />
        </a>
      </section>

      <section class="demoSection" id="demo-signup" aria-labelledby="demo-heading">
      <h2 class="demoHeading" id="demo-heading">Demo signup</h2>
      <p class="intro">
        Each demo is approximately 3 minutes and will be filmed unless you ask
        not to be recorded.
      </p>
      <p class="resetNote">Ten spots are available. The list resets each Tuesday.</p>

      <form class="signupForm" id="signup-form">
        <div class="fields">
          <label>
            <span>Your name</span>
            <input id="presenter-name" name="name" type="text" maxlength="60"
              autocomplete="name" placeholder="Enter your name" required />
          </label>
          <label>
            <span>Instagram handle <small>optional</small></span>
            <input id="instagram-handle" name="instagram" type="text" maxlength="30"
              autocomplete="off" placeholder="@yourhandle" />
          </label>
        </div>
        <button type="submit">Claim a spot</button>
      </form>

      <p class="status" id="signup-status" role="status" aria-live="polite">
        Loading demo signups…
      </p>

      <div class="listHeading">
        <div class="lineupTitle">
          <h3>Demo lineup</h3>
          <span id="spot-count">0 / 10</span>
        </div>
        <h3>Instagram</h3>
      </div>
      <ol class="signupList" id="signup-list"></ol>
      </section>
    </div>
  </main>

  <script>
    const page = document.querySelector<HTMLElement>(".signupPage");
    const form = document.querySelector<HTMLFormElement>("#signup-form");
    const input = document.querySelector<HTMLInputElement>("#presenter-name");
    const instagramInput = document.querySelector<HTMLInputElement>("#instagram-handle");
    const button = form?.querySelector<HTMLButtonElement>("button");
    const list = document.querySelector<HTMLOListElement>("#signup-list");
    const status = document.querySelector<HTMLElement>("#signup-status");
    const count = document.querySelector<HTMLElement>("#spot-count");
    const meetingDate = document.querySelector<HTMLElement>("#meeting-date");
    const progress = document.querySelector<HTMLElement>("#meeting-progress");
    const progressFill = document.querySelector<HTMLElement>("#progress-fill");
    const progressStatus = document.querySelector<HTMLElement>("#progress-status");
    const endpoint = page?.dataset.signupEndpoint ?? "";
    const capacity = 10;

    function setStatus(message: string, isError = false) {
      if (!status) return;
      status.textContent = message;
      status.classList.toggle("error", isError);
    }

    type Presenter = { name: string; instagram?: string };

    function render(presenters: Presenter[]) {
      if (!list || !count || !button || !input || !instagramInput) return;
      list.replaceChildren();
      for (let index = 0; index < capacity; index += 1) {
        const item = document.createElement("li");
        const presenter = presenters[index];
        if (presenter) {
          const name = document.createElement("span");
          name.textContent = presenter.name;
          item.append(name);
          if (presenter.instagram) {
            const handle = document.createElement("a");
            handle.className = "instagram";
            const username = presenter.instagram.replace(/^@/, "");
            handle.textContent = `@${username}`;
            handle.href = `https://www.instagram.com/${username}/`;
            handle.target = "_blank";
            handle.rel = "noreferrer";
            handle.setAttribute("aria-label", `${presenter.name} on Instagram`);
            item.append(handle);
          }
        } else {
          item.textContent = "Available";
          item.classList.add("available");
        }
        list.append(item);
      }
      count.textContent = `${presenters.length} / ${capacity}`;
      const isFull = presenters.length >= capacity;
      button.disabled = isFull;
      input.disabled = isFull;
      instagramInput.disabled = isFull;
      if (isFull) setStatus("This meeting’s demo list is full.");
    }

    function presentersFrom(data: { presenters?: Presenter[]; names?: string[] }) {
      if (Array.isArray(data.presenters)) return data.presenters;
      return Array.isArray(data.names) ? data.names.map((name) => ({ name })) : [];
    }

    function showMeetingDate(date: string | undefined) {
      if (!date || !meetingDate) return;
      const parsed = new Date(`${date}T12:00:00`);
      meetingDate.textContent = parsed.toLocaleDateString("en-US", {
        weekday: "long", month: "long", day: "numeric",
      });
    }

    function currentMeetingTuesday() {
      const parts = new Intl.DateTimeFormat("en-US", {
        timeZone: "America/New_York",
        year: "numeric",
        month: "2-digit",
        day: "2-digit",
      }).formatToParts(new Date());
      const value = (type: "year" | "month" | "day") =>
        Number(parts.find((part) => part.type === type)?.value);
      const date = new Date(Date.UTC(value("year"), value("month") - 1, value("day")));
      const daysSinceTuesday = (date.getUTCDay() - 2 + 7) % 7;
      date.setUTCDate(date.getUTCDate() - daysSinceTuesday);
      return date.toISOString().slice(0, 10);
    }

    function updateMeetingProgress() {
      if (!progress || !progressFill || !progressStatus) return;
      const parts = new Intl.DateTimeFormat("en-US", {
        timeZone: "America/New_York",
        year: "numeric",
        month: "2-digit",
        day: "2-digit",
        hour: "2-digit",
        minute: "2-digit",
        second: "2-digit",
        hourCycle: "h23",
      }).formatToParts(new Date());
      const value = (type: "year" | "month" | "day" | "hour" | "minute" | "second") =>
        Number(parts.find((part) => part.type === type)?.value);
      const localDate = `${value("year")}-${String(value("month")).padStart(2, "0")}-${String(value("day")).padStart(2, "0")}`;
      const meetingTuesday = currentMeetingTuesday();
      const minutes = value("hour") * 60 + value("minute") + value("second") / 60;
      let percent = localDate > meetingTuesday ? 100 : 0;

      if (localDate === meetingTuesday) {
        percent = Math.max(0, Math.min(100, ((minutes - 18 * 60) / 120) * 100));
      }

      progressFill.style.height = `${percent}%`;
      progress.setAttribute("aria-valuenow", String(Math.round(percent)));
      if (percent <= 0) progressStatus.textContent = "Meetup starts at 6 PM";
      else if (percent >= 100) progressStatus.textContent = "Meetup complete";
      else progressStatus.textContent = `Meetup in progress · ${Math.round(percent)}%`;
    }

    async function loadSignups() {
      if (!endpoint) {
        form?.setAttribute("hidden", "");
        setStatus("Signups aren’t configured yet. Please check back soon.", true);
        render([]);
        return;
      }
      try {
        const response = await fetch(`${endpoint}?action=list&t=${Date.now()}`);
        const data = await response.json();
        if (!response.ok || !data.ok) throw new Error(data.error || "Could not load signups");
        const presenters = presentersFrom(data);
        showMeetingDate(data.meetingDate || data.date);
        render(presenters);
        if (presenters.length < capacity) setStatus("Choose an available spot by entering your name.");
      } catch (error) {
        console.error(error);
        setStatus("Couldn’t load today’s signups. Please try again.", true);
      }
    }

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const name = input?.value.trim() ?? "";
      const instagram = instagramInput?.value.trim().replace(/^@/, "") ?? "";
      if (!name || !button || !input || !instagramInput) return;
      button.disabled = true;
      input.disabled = true;
      instagramInput.disabled = true;
      setStatus("Saving your spot…");
      try {
        const body = new URLSearchParams({ action: "signup", name, instagram });
        const response = await fetch(endpoint, { method: "POST", body });
        const data = await response.json();
        if (!response.ok || !data.ok) throw new Error(data.error || "Could not save signup");
        showMeetingDate(data.meetingDate || data.date);
        render(presentersFrom(data));
        form.reset();
        setStatus(`You’re signed up, ${name}!`);
      } catch (error) {
        console.error(error);
        setStatus(error instanceof Error ? error.message : "Couldn’t save your spot. Please try again.", true);
        button.disabled = false;
        input.disabled = false;
        instagramInput.disabled = false;
      }
    });

    showMeetingDate(currentMeetingTuesday());
    updateMeetingProgress();
    window.setInterval(updateMeetingProgress, 15000);
    loadSignups();
  </script>

  <style>
    .signupPage { position: relative; box-sizing: border-box; width: min(1180px, calc(100% - 48px)); margin: 0 auto; padding: 64px 0 80px; }
    .siteIntro { margin-bottom: 64px; }
    .brandLink { display: inline-block; color: white; font-family: "Tanker", monospace; font-size: clamp(5rem, 16vw, 8rem); line-height: .85; text-decoration: none; }
    .siteIntro p { margin: 8px 0 0; color: var(--theme-gray); font-size: 1.05rem; }
    .meetingDate { position: absolute; top: 72px; right: 0; margin: 0; color: #ff3b30; font-size: 1rem; font-weight: bold; letter-spacing: .08em; text-transform: uppercase; }
    .eyebrow { margin: 0 0 10px; color: var(--theme-gray); font-size: .8rem; letter-spacing: .14em; text-transform: uppercase; }
    h1 { margin: 0; font-family: "Tanker", monospace; font-size: clamp(3rem, 10vw, 5.5rem); font-weight: normal; line-height: .95; }
    .progressStatus { margin: 18px 0 0; color: var(--theme-gray); font-size: .8rem; letter-spacing: .06em; text-transform: uppercase; }
    .agendaBody { display: grid; grid-template-columns: 38px minmax(0, 1fr); gap: 22px; margin-top: 34px; }
    .meetingProgress { display: flex; justify-content: center; }
    .progressTrack { position: relative; width: 12px; min-height: 210px; border: 1px solid #ff3b30; background: rgb(45, 45, 45); }
    .progressTrack::before, .progressTrack::after { position: absolute; left: 50%; z-index: 2; box-sizing: border-box; width: 16px; height: 16px; border: 3px solid #ff3b30; border-radius: 50%; background: var(--background-color); content: ""; }
    .progressTrack::before { top: 0; transform: translate(-50%, -50%); }
    .progressTrack::after { bottom: 0; transform: translate(-50%, 50%); }
    .progressTrack span { display: block; width: 100%; height: 0; background: #ff3b30; transition: height 1s linear; }
    .intro { max-width: 610px; margin: 22px 0 8px; font-size: 1.15rem; line-height: 1.5; }
    .resetNote { margin: 0; color: var(--theme-gray); }
    :global(html) { scroll-behavior: smooth; }
    .contentGrid { display: grid; gap: 56px; }
    .agendaSection { display: grid; grid-template-columns: minmax(0, 1fr) auto; column-gap: 72px; }
    .agendaSection header, .agendaBody { grid-column: 1; }
    .agenda { display: grid; align-content: space-between; margin: 0; padding: 0; list-style: none; }
    .agenda li { position: relative; display: grid; grid-template-columns: 120px 1fr; gap: 24px; padding: 10px 4px; }
    .agenda li::before { position: absolute; top: 12px; left: -48px; z-index: 1; box-sizing: border-box; width: 14px; height: 14px; border: 3px solid #ff3b30; border-radius: 50%; background: var(--background-color); content: ""; }
    .agenda time { color: #ff3b30; font-weight: bold; }
    .agenda strong, .agenda span { display: block; }
    .agenda span { margin-top: 5px; color: var(--theme-gray); line-height: 1.4; }
    .qrPrompt { display: flex; grid-column: 2; grid-row: 1 / span 2; align-self: center; align-items: center; flex-direction: column; width: max-content; color: white; gap: 18px; text-align: center; text-decoration: none; }
    .qrPrompt img { display: block; width: 150px; height: 150px; }
    .qrCopy small, .qrCopy strong { display: block; text-transform: uppercase; }
    .qrCopy small { margin-top: 8px; color: var(--theme-gray); font-size: .75rem; font-weight: normal; letter-spacing: .16em; }
    .qrCopy strong { font-family: "Tanker", monospace; font-size: 2rem; font-weight: normal; letter-spacing: .03em; line-height: .95; }
    .demoSection { scroll-margin-top: 40px; }
    .demoHeading { margin: 0; font-family: "Tanker", monospace; font-size: clamp(2.5rem, 8vw, 4rem); font-weight: normal; line-height: 1; }
    .signupForm { margin: 40px 0 18px; }
    .fields { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 12px; }
    label, label span { display: block; }
    label span { margin-bottom: 8px; }
    label small { color: var(--theme-gray); font-size: .75em; font-weight: normal; }
    input, button { box-sizing: border-box; min-height: 48px; border: 1px solid var(--theme-gray); border-radius: 0; font: inherit; }
    input { width: 100%; min-width: 0; padding: 0 14px; background: transparent; color: white; }
    button { width: 100%; padding: 0 20px; background: #ff3b30; border-color: #ff3b30; color: white; cursor: pointer; font-weight: bold; }
    button:disabled, input:disabled { cursor: not-allowed; opacity: .55; }
    input:focus-visible, button:focus-visible, .brandLink:focus-visible { outline: 2px solid white; outline-offset: 3px; }
    .status { min-height: 1.3em; margin: 0 0 42px; color: var(--theme-gray); }
    .status.error { color: #ff9e9e; }
    .listHeading { display: flex; align-items: baseline; justify-content: space-between; gap: 20px; border-bottom: 1px solid var(--theme-gray); }
    .lineupTitle { display: flex; align-items: baseline; gap: 12px; }
    h3 { margin: 0 0 12px; font-size: 1rem; font-weight: normal; letter-spacing: .08em; text-transform: uppercase; }
    #spot-count { color: var(--theme-gray); }
    .signupList { margin: 0; padding: 0; list-style-position: inside; }
    .signupList li { display: flex; justify-content: space-between; gap: 18px; padding: 15px 4px; border-bottom: 1px solid rgb(65, 65, 65); }
    .signupList li::marker { color: var(--theme-gray); }
    .signupList .available { color: rgb(115, 115, 115); font-style: italic; }
    .signupList .instagram { color: var(--theme-gray); text-align: right; }
    @media (prefers-reduced-motion: reduce) {
      :global(html) { scroll-behavior: auto; }
    }
    @media (max-width: 900px) {
      .signupPage { width: min(680px, calc(100% - 40px)); }
      .meetingDate { position: static; margin: -38px 0 52px; }
      .contentGrid { gap: 56px; }
      .agendaSection { grid-template-columns: 1fr; }
      .qrPrompt { grid-column: 1; grid-row: auto; margin: 56px auto 0; }
    }
    @media (max-width: 520px) {
      .signupPage { padding-top: 32px; }
      .siteIntro { margin-bottom: 48px; }
      .agenda li { grid-template-columns: 1fr; gap: 6px; }
      .qrPrompt { gap: 16px; }
      .qrPrompt img { width: 120px; height: 120px; }
      .qrCopy strong { font-size: 1.6rem; }
      .fields { grid-template-columns: 1fr; }
    }
  </style>
</Layout>
