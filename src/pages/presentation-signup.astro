---
import Layout from "../layouts/Layout.astro";

const signupEndpoint =
  import.meta.env.PUBLIC_PRESENTATION_SIGNUP_URL ??
  "https://script.google.com/macros/s/AKfycbw6w4MBmMNpoyrF03s82wi9ZuRg__5lBwJp8NYbUBJ1NKEAmvTKJDqjRxDTbcfqptna/exec";
---

<Layout>
  <main class="signupPage" data-signup-endpoint={signupEndpoint}>
    <a class="backLink" href="/">← CCNYC</a>

    <header>
      <p class="eyebrow">Show & tell</p>
      <h1>Presentation signup</h1>
      <p class="intro">
        Presentations are ~3 minutes long. Sign up below to share something
        you’ve made, learned, or are curious about.
      </p>
      <p class="resetNote">Ten spots are available. The list resets each day.</p>
    </header>

    <form class="signupForm" id="signup-form">
      <label for="presenter-name">Your name</label>
      <div class="formRow">
        <input id="presenter-name" name="name" type="text" maxlength="60"
          autocomplete="name" placeholder="Enter your name" required />
        <button type="submit">Claim a spot</button>
      </div>
    </form>

    <p class="status" id="signup-status" role="status" aria-live="polite">
      Loading today’s signups…
    </p>

    <section aria-labelledby="today-heading">
      <div class="listHeading">
        <h2 id="today-heading">Today’s presenters</h2>
        <span id="spot-count">0 / 10</span>
      </div>
      <ol class="signupList" id="signup-list"></ol>
    </section>
  </main>

  <script>
    const page = document.querySelector<HTMLElement>(".signupPage");
    const form = document.querySelector<HTMLFormElement>("#signup-form");
    const input = document.querySelector<HTMLInputElement>("#presenter-name");
    const button = form?.querySelector<HTMLButtonElement>("button");
    const list = document.querySelector<HTMLOListElement>("#signup-list");
    const status = document.querySelector<HTMLElement>("#signup-status");
    const count = document.querySelector<HTMLElement>("#spot-count");
    const endpoint = page?.dataset.signupEndpoint ?? "";
    const capacity = 10;

    function setStatus(message: string, isError = false) {
      if (!status) return;
      status.textContent = message;
      status.classList.toggle("error", isError);
    }

    function render(names: string[]) {
      if (!list || !count || !button || !input) return;
      list.replaceChildren();
      for (let index = 0; index < capacity; index += 1) {
        const item = document.createElement("li");
        const name = names[index];
        item.textContent = name || "Available";
        item.classList.toggle("available", !name);
        list.append(item);
      }
      count.textContent = `${names.length} / ${capacity}`;
      const isFull = names.length >= capacity;
      button.disabled = isFull;
      input.disabled = isFull;
      if (isFull) setStatus("Today’s presentation list is full.");
    }

    async function loadSignups() {
      if (!endpoint) {
        form?.setAttribute("hidden", "");
        setStatus("Signups aren’t configured yet. Please check back soon.", true);
        render([]);
        return;
      }
      try {
        const response = await fetch(`${endpoint}?action=list&t=${Date.now()}`);
        const data = await response.json();
        if (!response.ok || !data.ok) throw new Error(data.error || "Could not load signups");
        const names = Array.isArray(data.names) ? data.names : [];
        render(names);
        if (names.length < capacity) setStatus("Choose an available spot by entering your name.");
      } catch (error) {
        console.error(error);
        setStatus("Couldn’t load today’s signups. Please try again.", true);
      }
    }

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const name = input?.value.trim() ?? "";
      if (!name || !button || !input) return;
      button.disabled = true;
      input.disabled = true;
      setStatus("Saving your spot…");
      try {
        const body = new URLSearchParams({ action: "signup", name });
        const response = await fetch(endpoint, { method: "POST", body });
        const data = await response.json();
        if (!response.ok || !data.ok) throw new Error(data.error || "Could not save signup");
        render(data.names);
        form.reset();
        setStatus(`You’re signed up, ${name}!`);
      } catch (error) {
        console.error(error);
        setStatus(error instanceof Error ? error.message : "Couldn’t save your spot. Please try again.", true);
        button.disabled = false;
        input.disabled = false;
      }
    });

    loadSignups();
  </script>

  <style>
    .signupPage { box-sizing: border-box; width: min(680px, calc(100% - 40px)); margin: 0 auto; padding: 64px 0 80px; }
    .backLink { display: inline-block; margin-bottom: 64px; text-decoration: none; }
    .eyebrow { margin: 0 0 10px; color: var(--theme-gray); font-size: .8rem; letter-spacing: .14em; text-transform: uppercase; }
    h1 { margin: 0; font-family: "Tanker", monospace; font-size: clamp(3rem, 10vw, 5.5rem); font-weight: normal; line-height: .95; }
    .intro { max-width: 610px; margin: 28px 0 8px; font-size: 1.2rem; line-height: 1.5; }
    .resetNote { margin: 0; color: var(--theme-gray); }
    .signupForm { margin: 48px 0 18px; }
    label { display: block; margin-bottom: 8px; }
    .formRow { display: flex; gap: 10px; }
    input, button { box-sizing: border-box; min-height: 48px; border: 1px solid var(--theme-gray); border-radius: 0; font: inherit; }
    input { flex: 1; min-width: 0; padding: 0 14px; background: transparent; color: white; }
    button { padding: 0 20px; background: white; color: var(--background-color); cursor: pointer; font-weight: bold; }
    button:disabled, input:disabled { cursor: not-allowed; opacity: .55; }
    input:focus-visible, button:focus-visible, .backLink:focus-visible { outline: 2px solid white; outline-offset: 3px; }
    .status { min-height: 1.3em; margin: 0 0 42px; color: var(--theme-gray); }
    .status.error { color: #ff9e9e; }
    .listHeading { display: flex; align-items: baseline; justify-content: space-between; gap: 20px; border-bottom: 1px solid var(--theme-gray); }
    h2 { margin: 0 0 12px; font-size: 1rem; font-weight: normal; letter-spacing: .08em; text-transform: uppercase; }
    #spot-count { color: var(--theme-gray); }
    .signupList { margin: 0; padding: 0; list-style-position: inside; }
    .signupList li { padding: 15px 4px; border-bottom: 1px solid rgb(65, 65, 65); }
    .signupList li::marker { color: var(--theme-gray); }
    .signupList .available { color: rgb(115, 115, 115); font-style: italic; }
    @media (max-width: 520px) {
      .signupPage { padding-top: 32px; }
      .backLink { margin-bottom: 48px; }
      .formRow { flex-direction: column; }
    }
  </style>
</Layout>
