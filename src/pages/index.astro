---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import instagramIcon from "./../assets/instagram-white-icon.png";
---

<Layout>
  <div class="centeredContainer">
    <div class="titleContainer">
      <div class="ccnycTitle">CCNYC</div>
      <div class="ccnycSubtitle">creative coding nyc</div>
    </div>
    <div class="textContainer">
      <p>
        Check <a href="https://calendar.google.com/calendar/u/0/newembed?src=af7c6ae752c79810e8eb38e75cdf47faed42d35a9a68372067572cad4a6ec400@group.calendar.google.com" target="_blank">our calendar</a> for our next meetup! We also announce meetups on our <a
          href="https://www.instagram.com/creativecodingnyc/"
          target="_blank"
          rel="noreferrer"
        >
          Instagram</a
        > with digital posters made by CCNYCers!
      </p>
      <hr>
      <p>
        Creative Coding NYC is a weekly community meetup for anyone interested
        in bringing their creative ideas to life using code. Everyone is
        welcome! People from all backgrounds come to our meetups, from
        non-technical artists to veteran programmers. Our top priority at CCNYC
        is to foster an inclusive, welcoming environment where members can
        support and learn from one another.
      </p><p>
        Our gatherings are a space to:
        <ul>
          <li>Work on individual projects or collaborate with others</li>
          <li>Get creative or technical feedback</li>
          <li>Have discussions on creative coding</li>
          <li>Share resources, other artists' work, ideas, etc.</li>
          <li>Learn independently or with others</li>
          <li>
            Build relationships with others in the creative coding community :)
          </li>
        </ul>
      </p>
      <p>
      </p>
      <hr>
      <div class="socialsContainer">
        <a
          href="https://www.instagram.com/creativecodingnyc/"
          target="_blank"
          rel="noreferrer"
        >
          <Image src={instagramIcon} alt="Instagram icon" class="instaIcon" />
        </a>
      </div>
    </div>
  </div>

  <style>
    .centeredContainer {
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-direction: column;
      padding: 60px 0;
      box-sizing: border-box;
    }

    @media (height < 1000px) {
      .centeredContainer {
        justify-content: unset;
        padding-top: 100px;
        height: unset;
      }
    }

    .titleContainer {
      display: flex;
      flex-direction: column;
      align-items: center;
      margin-bottom: 30px;
    }

    .ccnycTitle {
      font-size: 4.5rem;
      font-family: "Tanker", monospace;
    }

    .ccnycSubtitle {
      font-style: italic;
    }

    .textContainer {
      width: clamp(300px, 60%, 800px);
    }

    .missionStatementTitle {
      text-transform: uppercase;
      color: var(--theme-gray);
    }

    .socialsContainer {
      display: flex;
      justify-content: center;
      margin-top: 30px;
    }

    .instaIcon {
      width: 40px;
      height: unset;
    }
  </style>
</Layout>
